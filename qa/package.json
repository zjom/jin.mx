{
  "name": "qa-jin-mx",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check": "node scripts/check.js",
    "build": "node scripts/check.js && vite build",
    "preview": "pnpm run build && wrangler dev",
    "deploy": "pnpm run build && wrangler deploy && wrangler d1 migrations apply qa --remote",
    "db:local": "wrangler d1 migrations apply qa --local",
    "invite": "node scripts/invite.js"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "vite": "^8.3.4",
    "wrangler": "^4.151.3"
  }
}
