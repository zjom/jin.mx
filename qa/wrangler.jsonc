{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "qa-jin-mx",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-19",
  "observability": {
    "enabled": true,
  },
  "routes": [{ "pattern": "qa.jin.mx", "custom_domain": true }],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  // Customer progress and every submission. With no database_id, wrangler
  // creates the database on the first deploy
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "qa",
      "migrations_dir": "migrations",
    },
  ],
  // Public submissions: 10 a minute per visitor
  "ratelimits": [
    {
      "name": "SUBMIT_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 },
    },
  ],
  "preview_urls": false,
}
