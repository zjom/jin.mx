{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "qa-jin-mx",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-19",
  "observability": {
    "enabled": true,
  },
  "routes": [{ "pattern": "qa.jin.mx", "custom_domain": true }],
  "workers_dev": false,
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/admin", "/admin/*"],
  },
  // /admin is behind Cloudflare Access, and the worker checks Access's
  // signature on every request to it. Until both of these are filled in from
  // the Access application, /admin answers no one
  "vars": {
    // <team>.cloudflareaccess.com
    "ACCESS_TEAM_DOMAIN": "",
    // The application's "Application Audience (AUD) Tag"
    "ACCESS_AUD": "",
  },
  // Customer progress and every submission. With no database_id, wrangler
  // creates the database on the first deploy
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "qa",
      "migrations_dir": "migrations",
    },
  ],
  // Files added to file questions. Private: nothing here is served back
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "qa-uploads" }],
  // Per visitor: 10 submissions and 30 file uploads a minute
  "ratelimits": [
    {
      "name": "UPLOAD_LIMIT",
      "namespace_id": "1002",
      "simple": { "limit": 30, "period": 60 },
    },
    {
      "name": "SUBMIT_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 },
    },
  ],
  "preview_urls": false,
  // `pnpm preview` would otherwise tell the worker it is at qa.jin.mx, and
  // /admin lets no one in there without Access
  "dev": { "host": "localhost" },
}
